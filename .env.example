# Postgres
POSTGRES_DB=blogdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bloguser
POSTGRES_PASSWORD=secret_pass

# Redis
REDIS_DATABASE=0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=redis_secret

# Kafka
KAFKA_TOPIC=notification
KAFKA_BROKER_HOST=kafka
KAFKA_BROKER_PORT=9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_BROKER_ID=1

# Zookeeper
KAFKA_ZOOKEEPER_PORT=2181


# Auth
SECRET_KEY=super-secret-key 256 hex
EXPIRY=60000000000

# RMP
PUBLIC_RPM=5
PROTECTED_RPM=10

# Logging
LOG_LEVEL=info

# Ports
USER_HTTP_PORT=8080
POST_HTTP_PORT=8081
NOTIFICATION_HTTP_PORT=8082
GRPC_PORT=50051
